# Copy to .env and fill in. Never commit .env.
HF_TOKEN=hf_xxx                       # Hugging Face write token (in Colab: store as a Secret named HF_TOKEN)
HF_NAMESPACE=your-hf-username-or-org  # e.g. mbg-ai
HF_DATASET_REPO=mbg-chat-dataset      # private dataset repo
HF_MODEL_REPO=qwen-mbg-lora           # private repo for LoRA checkpoints / adapter
HF_GGUF_REPO=qwen-mbg-gguf            # private repo for the 4-bit GGUF
BASE_MODEL=unsloth/Qwen2.5-7B-Instruct-bnb-4bit   # confirm the newest Qwen 7–8B instruct at Level 2
